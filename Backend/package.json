{
  "name": "exam-hall-management-backend",
  "version": "1.0.0",
  "description": "Backend for Exam Hall Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:simple": "jest --no-coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "seed": "node seedData.js",
    "seed-fresh": "node seedFresh.js",
    "reset-db": "node resetDatabase.js",
    "seed-test-users": "node scripts/seed-test-users.js",
    "create-admin": "node scripts/create-admin.js"
  },
  "keywords": [
    "exam",
    "hall",
    "management",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.2",
    "eslint": "^8.45.0",
    "jest": "^29.6.2",
    "jest-watch-typeahead": "^2.2.2",
    "mongodb-memory-server": "^9.5.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.0",
    "supertest": "^6.3.3"
  }
}
